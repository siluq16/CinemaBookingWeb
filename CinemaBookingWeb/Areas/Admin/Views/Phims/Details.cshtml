@model CinemaBookingWeb.Models.Phim

@{
    ViewData["Title"] = "Chi tiết phim";
}

<div class="container-fluid mt-3">
    <h4 class="mb-3">Chi tiết phim: <span class="text-primary fw-bold">@Model.TenPhim</span></h4>
    <div class="card border-0 shadow-sm p-4">
        <div class="row g-3">
            <!-- Cột trái: thông tin cơ bản -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Tên phim:</label>
                    <div class="fs-5">@Model.TenPhim</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Thể loại:</label>
                    <div class="fs-5">@Model.TheLoai</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Diễn viên:</label>
                    <div class="fs-6">@Model.DienVien</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Thời lượng (phút):</label>
                    <div class="fs-6">@Model.ThoiLuong</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Ngày khởi chiếu:</label>
                    <div class="fs-6">@Model.NgayKhoiChieu.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Ngày kết thúc:</label>
                    <div class="fs-6">@Model.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "-"</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Mô tả:</label>
                    <div class="fs-6">@Model.MoTa</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Độ tuổi:</label>
                    <div class="fs-6">@Model.DoTuoi?.ToString()</div>
                </div>
            </div>

            <!-- Cột phải: thông tin bổ sung -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Đạo diễn:</label>
                    <div class="fs-6">@Model.DaoDien</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Trailer:</label>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.Trailer))
                        {
                            <a href="@Model.Trailer" target="_blank" class="text-decoration-underline">@Model.Trailer</a>
                        }
                        else
                        {
                            <span>Chưa có trailer</span>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-secondary small">Poster:</label>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.Poster))
                        {
                            <img src="~/images/poster/@Model.Poster"
                                 alt="@Model.TenPhim Poster"
                                 class="rounded border"
                                 style="width: 200px;" />
                        }
                        else
                        {
                            <span>Chưa có poster</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="text-end mt-3">
            <a asp-action="Edit" asp-route-id="@Model.MaPhim" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
</div>
