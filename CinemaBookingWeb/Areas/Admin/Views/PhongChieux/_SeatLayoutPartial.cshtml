@model CinemaBookingWeb.Areas.Admin.Models.SeatLayoutViewModel

<style>
    .seat {
        width: 35px;
        height: 35px;
        border-radius: 6px;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 1px;
        color: #fff;
        cursor: default;
        user-select: none;
    }

    .seat-normal {
        background-color: #6f42c1;
    }

    .seat-vip {
        background-color: #dc3545;
    }

    .seat-couple {
        background-color: #e83e8c;
    }

    .seat-row {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 2px;
    }

    .edit-col {
        margin-left: 6px;
    }

    .screen {
        background-color: #343a40;
        color: white;
        text-align: center;
        padding: 6px;
        border-radius: 5px;
        margin-bottom: 15px;
        font-weight: bold;
    }
</style>

<div class="text-center mb-3">
    <div class="screen">MÀN HÌNH</div>
</div>

<div class="d-flex flex-column align-items-center">

    @foreach (var rowGroup in Model.GheNgois.GroupBy(g => g.HangGhe))
    {
        var rowName = rowGroup.Key;
        <div class="seat-row" data-row="@rowName">
            @foreach (var seat in rowGroup.OrderBy(g => g.CotGhe))
            {
                var cls = seat.LoaiGhe switch
                {
                    "VIP" => "seat-vip",
                    "COUPLE" => "seat-couple",
                    _ => "seat-normal"
                };

                <div class="seat @cls" data-id="@seat.MaGhe" data-row="@seat.HangGhe" data-col="@seat.CotGhe" data-type="@seat.LoaiGhe">
                    @seat.CotGhe
                </div>
            }

            <!-- Dropdown đổi loại ghế theo hàng -->
            <div class="edit-col">
                <div class="dropdown">
                    <button class="btn btn-success btn-sm p-1" data-bs-toggle="dropdown">
                        <i class="bi bi-gear"></i>
                    </button>
                    <ul class="dropdown-menu shadow p-2">
                        <li>
                            <button class="dropdown-item change-row-type" data-type="Normal" data-row="@rowName">
                                <span class="seat-normal-dot seat-dot"></span> Ghế Normal
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item change-row-type" data-type="VIP" data-row="@rowName">
                                <span class="seat-vip-dot seat-dot"></span> Ghế VIP
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item change-row-type" data-type="COUPLE" data-row="@rowName">
                                <span class="seat-couple-dot seat-dot"></span> Ghế Couple
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4 text-center">
    <div class="mt-3 d-flex justify-content-center">
        <div class="seat-legend d-grid" style="grid-template-columns: repeat(2, auto); gap: 10px 40px;">
            <div class="d-flex align-items-center gap-2"><div style="width:18px;height:18px;background:#6f42c1;border-radius:3px;"></div> Ghế Normal</div>
            <div class="d-flex align-items-center gap-2"><div style="width:18px;height:18px;background:#dc3545;border-radius:3px;"></div> Ghế VIP</div>
            <div class="d-flex align-items-center gap-2"><div style="width:18px;height:18px;background:#e83e8c;border-radius:3px;"></div> Ghế COUPLE</div>
            <div class="d-flex align-items-center gap-2"><div style="width:18px;height:18px;background:#343a40;border-radius:3px;"></div> Không sử dụng</div>
        </div>
    </div>
</div>