<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trang Quản Trị</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CinemaBookingWeb.styles.css" asp-append-version="true" />
</head>
<body class="admin-layout">
    <div class="admin-container d-flex">
        <!-- SIDEBAR -->
        @await Html.PartialAsync("_AdminSidebar")


        <!-- CONTENT -->
        <div class="admin-content flex-grow-1">
            <!-- HEADER TRÊN -->
            @await Html.PartialAsync("_AdminHeader")


            <!-- NỘI DUNG TRANG -->
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const groups = document.querySelectorAll('.menu-group');

            // --- Lấy activeHref từ sessionStorage ---
            let activeHref = sessionStorage.getItem('activeMenu');

            // Nếu không có, mặc định chọn Dashboard đầu tiên
            if (!activeHref) {
                const dashboardMenu = groups[0];
                const defaultLink = dashboardMenu.querySelector('.submenu a[href]');
                activeHref = defaultLink ? defaultLink.getAttribute('href') : '#';
                sessionStorage.setItem('activeMenu', activeHref);
            }

            groups.forEach(group => {
                const toggle = group.querySelector('.menu-toggle');
                const submenu = group.querySelector('.submenu');
                const icon = group.querySelector('.fa-chevron-down');
                const link = group.querySelector('a[href]:not(.menu-toggle)'); // menu đơn

                // --- Menu có submenu ---
                if (submenu) {
                    submenu.querySelectorAll('a[href]').forEach(a => {
                        if (a.getAttribute('href') === activeHref) {
                            a.classList.add('active');
                            submenu.classList.add('open');
                            if (icon) icon.classList.add('rotate');
                        }
                        // click menu con
                        a.addEventListener('click', function () {
                            // Xóa active cũ
                            document.querySelectorAll('.submenu a.active').forEach(el => el.classList.remove('active'));
                            this.classList.add('active');
                            sessionStorage.setItem('activeMenu', this.getAttribute('href'));
                        });
                    });

                    // click menu cha (toggle)
                    if (toggle) {
                        toggle.addEventListener('click', function (e) {
                            e.preventDefault();
                            submenu.classList.toggle('open');
                            if (icon) icon.classList.toggle('rotate');
                        });
                    }
                }

                // --- Menu đơn không có submenu ---
                if (link) {
                    if (link.getAttribute('href') === activeHref) {
                        link.classList.add('active');
                    }

                    link.addEventListener('click', function () {
                        // Xóa active cũ
                        document.querySelectorAll('.submenu a.active').forEach(el => el.classList.remove('active'));
                        document.querySelectorAll('.menu-group > a.active').forEach(el => el.classList.remove('active'));

                        this.classList.add('active');
                        sessionStorage.setItem('activeMenu', this.getAttribute('href'));
                    });
                }
            });
        });
    </script>
    <style>
        /* Trong ~/css/admin.css */
        .breadcrumb-item + .breadcrumb-item::before {
            content: "/"; /* Thêm dấu / */
            color: #6c757d;
        }
        .breadcrumb-item a {
            color: #495057;
            font-size: 0.95rem;
        }
        .breadcrumb-item.active {
            font-weight: bold;
            color: #0d6efd !important;
        }
        .breadcrumb-item {
            font-size: 0.9rem;
        }
    </style>
</body>
</html>
