@model CinemaBookingWeb.Areas.Admin.Models.DashBoardViewModel
@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid px-4">
    <h2 class="mt-4 mb-4">Tổng quan</h2>

    <!-- Hàng 1: 4 thẻ thông tin -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Doanh thu trong ngày(@Model.Ngay/@Model.Thang/@Model.Nam)</h6>
                    <h4 class="text-primary fw-bold">@Model.DoanhThuNgay.ToString("N0") ₫</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Khách hàng mới (@Model.Thang/@Model.Nam)</h6>
                    <h4 class="text-success fw-bold">@Model.KhachHangMoi</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Tổng vé bán ra (@Model.Thang/@Model.Nam)</h6>
                    <h4 class="text-warning fw-bold">@Model.VeBanRa</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Tổng doanh thu (@Model.Thang/@Model.Nam)</h6>
                    <h4 class="text-danger fw-bold">@Model.TongDoanhThu.ToString("N0") ₫</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng 2: Biểu đồ -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div style="position: relative; height: 350px; width: 100%;">
                        <canvas id="chartPhim"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div style="position: relative; height: 350px; width: 100%;">
                        <canvas id="chartRap"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng 3: Bảng dữ liệu -->
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Doanh thu theo phim</h5>
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Tên Phim</th>
                                <th>Doanh Thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DoanhThuPhim != null && Model.DoanhThuPhim.Any())
                            {
                                int i = 1;
                                foreach (var item in Model.DoanhThuPhim)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.TenPhim</td>
                                        <td>@string.Format("{0:N0}", item.TongDoanhThu)</td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-muted">Không có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Doanh thu Tháng</h5>
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tháng</th>
                                <th>Doanh Thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DoanhThuPhong != null && Model.DoanhThuPhong.Any())
                            {
                                foreach (var item in Model.DoanhThuPhong)
                                {
                                    <tr>
                                        <td>@item.Thang</td>
                                        <td>@string.Format("{0:N0}", item.TongDoanhThu)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-muted">Không có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // === Nhận dữ liệu thật từ Model (chuyển sang JSON) ===
        var doanhThuPhim = @Html.Raw(Json.Serialize(Model.DoanhThuPhim));
        var doanhThuThang = @Html.Raw(Json.Serialize(Model.DoanhThuPhong));

        // === Biểu đồ doanh thu theo phim ===
                const ctxPhim = document.getElementById('chartPhim').getContext('2d');
        new Chart(ctxPhim, {
            type: 'bar',
            data: {
                labels: doanhThuPhim.map(x => x.tenPhim),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: doanhThuPhim.map(x => x.tongDoanhThu),
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Doanh thu theo phim trong tháng',
                        font: { size: 18, weight: 'bold' },
                        color: '#2c3e50'
                    },
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + context.formattedValue.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + ' VNĐ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => value.toLocaleString('vi-VN')
                        }
                    }
                }
            }
        });


        // === Biểu đồ doanh thu theo tháng ===
        const ctxRap = document.getElementById('chartRap').getContext('2d');
        new Chart(ctxRap, {
            type: 'line',
            data: {
                labels: doanhThuThang.map(x => x.thang),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: doanhThuThang.map(x => x.tongDoanhThu),
                    borderColor: 'rgba(255, 99, 132, 1)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Doanh thu các tháng trong năm',
                        font: { size: 18, weight: 'bold' },
                        color: '#2c3e50'
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => value.toLocaleString('vi-VN')
                        }
                    }
                }
            }
        });

    </script>
}

