@model IEnumerable<CinemaBookingWeb.Models.KhuyenMai>

@{
    ViewData["Title"] = "Danh sách khuyến mãi";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <div class="input-group w-auto mb-2 ms-2">
                <span class="input-group-text bg-light"><i class="bi bi-calendar-check"></i></span>
                <input type="date" class="form-control" id="filterStartDate" placeholder="Từ ngày" title="Lọc theo Ngày Bắt Đầu" />
                <span class="input-group-text bg-light ms-2">đến</span>
                <input type="date" class="form-control" id="filterEndDate" placeholder="Đến ngày" title="Lọc theo Ngày Kết Thúc" />

                <button class="btn btn-outline-primary ms-2" id="filterBtn">Lọc</button>
            </div>
        </div>
        <div>
            <button id="btnCreatePromotion" class="btn btn-primary me-2">
                <i class="bi bi-plus-circle"></i> Tạo khuyến mãi
            </button>
            <button onclick="location.reload();" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-repeat"></i> Làm mới
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-hover align-middle" id="promotionTable">
                <thead class="table-light">
                    <tr>
                        <th>Mã KM</th>
                        <th>Tên khuyến mãi</th>
                        <th data-orderable ="false">Giảm (%)</th>
                        <th data-orderable="false">Giảm (VNĐ)</th>
                        <th data-type="date">Bắt đầu</th> @* Có 2 cách: dùng data-type="date" VÀ data-sort, hoặc chỉ dùng data-sort *@
                        <th data-type="date">Kết thúc</th>
                        <th class="text-center" data-orderable="false">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="promotionTableBody">
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.MaKm">
                            <td>@item.MaKm</td>
                            <td>@item.TenKm</td>
                            <td>@(item.PhanTramGiam.HasValue? item.PhanTramGiam.Value.ToString() + "%" : "-")</td>
                            <td>@(item.SoTienGiam.HasValue? item.SoTienGiam.Value.ToString("N0") : "-")</td>
                            <td data-sort="@item.NgayBatDau.ToString("yyyy-MM-dd")">@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                            <td data-sort="@item.NgayKetThuc.ToString("yyyy-MM-dd")">@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary btn-edit me-1"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger btn-delete"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="promotionModal" tabindex="-1" aria-labelledby="promotionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="promotionModalLabel">Tạo khuyến mãi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formPromotion">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()" />
                    <input type="hidden" id="editMode" value="create" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã KM (Chỉ khi tạo mới)</label>
                        <input type="text" class="form-control" id="maKmInput" required maxlength="10" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên khuyến mãi</label>
                        <input type="text" class="form-control" id="tenKmInput" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả</label>
                        <textarea class="form-control" id="moTaInput" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Phần trăm giảm (%)</label>
                            <input type="number" class="form-control" id="phanTramGiamInput" min="0" max="100" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Số tiền giảm (VNĐ)</label>
                            <input type="number" class="form-control" id="soTienGiamInput" min="0" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Ngày bắt đầu</label>
                            <input type="date" class="form-control" id="ngayBatDauInput" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Ngày kết thúc</label>
                            <input type="date" class="form-control" id="ngayKetThucInput" required />
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Khởi tạo biến cho DataTable ngoài phạm vi ready để dễ dàng truy cập
        let promotionDataTable;

        // Khai báo các phần tử DOM
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const tbody = document.getElementById("promotionTableBody");
        const modal = new bootstrap.Modal(document.getElementById('promotionModal'));
        const form = document.getElementById('formPromotion');
        const title = document.getElementById('promotionModalLabel');
        const modeInput = document.getElementById('editMode');
        const maKmInput = document.getElementById('maKmInput');
        const tenKmInput = document.getElementById('tenKmInput');
        const moTaInput = document.getElementById('moTaInput');
        const phanTramGiamInput = document.getElementById('phanTramGiamInput');
        const soTienGiamInput = document.getElementById('soTienGiamInput');
        const ngayBatDauInput = document.getElementById('ngayBatDauInput');
        const ngayKetThucInput = document.getElementById('ngayKetThucInput');

        $(document).ready(function () {
            // --- 1. KHỞI TẠO DATATABLES ---
            promotionDataTable = $('#promotionTable').DataTable({
                "columnDefs": [
                    { "orderable": false, "targets": [2, 3, 6] } // Cột Thao tác
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json"
                },
                "order": [[4, "desc"]], // Sắp xếp mặc định theo Ngày Bắt Đầu (cột 4) giảm dần
                "pageLength": 15,
                "dom": '<"top"lf>rt<"bottom"ip><"clear">'
            });

            // --- 2. LOGIC LỌC TÙY CHỈNH (Filter) ---
            document.getElementById("filterBtn").addEventListener("click", function () {
                const startDate = document.getElementById("filterStartDate").value;
                const endDate = document.getElementById("filterEndDate").value;

                // Xóa tất cả các bộ lọc tùy chỉnh hiện có
                $.fn.dataTable.ext.search.length = 0;

                // Thêm bộ lọc Ngày Bắt Đầu/Kết Thúc
                $.fn.dataTable.ext.search.push(
                    function (settings, data, dataIndex) {
                        const rowNode = promotionDataTable.row(dataIndex).node();
                        const rowStartDate = rowNode.querySelector('td:nth-child(5)').dataset.date; // YYYY-MM-DD
                        const rowEndDate = rowNode.querySelector('td:nth-child(6)').dataset.date;   // YYYY-MM-DD

                        let match = true;

                        // Lọc theo Ngày Bắt Đầu
                        if (startDate && rowStartDate < startDate) {
                            match = false;
                        }

                        // Lọc theo Ngày Kết Thúc
                        if (endDate && rowEndDate > endDate) {
                            match = false;
                        }

                        return match;
                    }
                );

                // Vẽ lại bảng để áp dụng các bộ lọc mới
                promotionDataTable.draw();
            });


            // --- 3. LOGIC MODAL & AJAX (Tái cấu trúc) ---

            // Tạo mới
            document.getElementById('btnCreatePromotion').addEventListener('click', () => {
                modeInput.value = "create";
                title.textContent = "Tạo khuyến mãi";
                form.reset();
                maKmInput.disabled = false;
                modal.show();
            });

            // Sửa
            $('#promotionTableBody').on('click', '.btn-edit', function () {
                const row = $(this).closest('tr'); // Sử dụng jQuery để dễ dàng lấy hàng
                modeInput.value = "edit";
                title.textContent = "Chỉnh sửa khuyến mãi";
                maKmInput.disabled = true; 
                maKmInput.value = row.data('id');
                tenKmInput.value = row.find('td:nth-child(2)').text();
                let ptGiamText = row.find('td:nth-child(3)').text();
                phanTramGiamInput.value = ptGiamText === "-" ? "" : ptGiamText.replace('%', '');
                let soTienGiamText = row.find('td:nth-child(4)').text();
                soTienGiamInput.value = soTienGiamText === "-" ? "" : soTienGiamText.replace(/[^0-9]/g, '');
                ngayBatDauInput.value = row.find('td:nth-child(5)').data('sort');
                ngayKetThucInput.value = row.find('td:nth-child(6)').data('sort');
                modal.show();
            });

            // Xóa
            $('#promotionTableBody').on('click', '.btn-delete', function () {
                const row = $(this).closest('tr');
                const id = row.data('id');
                const ten = row.find('td:nth-child(2)').text();

                Swal.fire({
                    title: `Xóa khuyến mãi "${ten}"?`,
                    text: "Bạn sẽ không thể hoàn tác thao tác này!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Xóa",
                    cancelButtonText: "Hủy",
                    reverseButtons: true
                }).then(r => {
                    if (r.isConfirmed) {
                        fetch('/Admin/KhuyenMai/DeleteAjax', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                            },
                            body: JSON.stringify(id)
                        })
                        .then(res => res.json())
                        .then(data => {
                            Swal.fire({
                                icon: data.success ? "success" : "error",
                                title: data.message || "Không thể xóa khuyến mãi này."
                            }).then(() => {
                                if (data.success) {
                                    row.remove();
                                    displayPage(1);
                                }
                            });
                        })
                        .catch(() => {
                            Swal.fire({ icon: "error", title: "Lỗi kết nối khi xóa" });
                        });
                    }
                });
            });

            // Lưu tạo/sửa (Giữ nguyên logic)
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (phanTramGiamInput.value && soTienGiamInput.value) {
                    alert("Chỉ được nhập Phần trăm giảm HOẶC Số tiền giảm, không được nhập cả hai.");
                    return;
                }
                if (!phanTramGiamInput.value && !soTienGiamInput.value) {
                    alert("Vui lòng nhập Phần trăm giảm HOẶC Số tiền giảm.");
                    return;
                }
                const data = {
                    MaKm: maKmInput.value,
                    TenKm: tenKmInput.value,
                    MoTa: moTaInput.value,
                    PhanTramGiam: phanTramGiamInput.value ? parseInt(phanTramGiamInput.value) : null,
                    SoTienGiam: soTienGiamInput.value ? parseFloat(soTienGiamInput.value) : null,
                    NgayBatDau: ngayBatDauInput.value,
                    NgayKetThuc: ngayKetThucInput.value
                };
                fetch('/Admin/KhuyenMai/SaveAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(data)
                })
                .then(res => res.json())
                .then(res => {
                    Swal.fire({
                        icon: res.success ? "success" : "error",
                        title: res.message
                    }).then(() => {
                        if(res.success){
                            location.reload();
                        }
                    });
                })
                .catch(() => {
                    Swal.fire({ icon: "error", title: "Lỗi khi lưu.", text: "Không thể kết nối đến máy chủ." });
                });
            });
        });
    </script>
    <style>
        .dataTables_wrapper .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
            border-radius: 0.5rem; /* 8px */
            font-size: 0.9rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            max-width: 150px;
        }

        .dataTables_wrapper .dataTables_length select {
            padding-right: 1.8rem !important;
            background-position: right 0.75rem center; /* Mặc định của Bootstrap */
            background-size: 16px 12px;
            /* Tùy chọn: Đảm bảo văn bản không bị tràn */
            text-overflow: ellipsis;
        }

            /* 2. HIỆU ỨNG FOCUS: Tương tự Bootstrap */
            .dataTables_wrapper .dataTables_filter input:focus,
            .dataTables_wrapper .dataTables_length select:focus {
                border-color: #80bdff; /* Màu xanh khi focus */
                box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
                outline: none; /* Bỏ outline mặc định */
            }

        .dataTables_wrapper .dataTables_filter label {
            /* Đảm bảo chữ "Tìm kiếm" không bị dính vào input */
            font-weight: 500;
            margin-right: 0.5rem;
        }

        /* 4. ĐIỀU CHỈNH CHUẨN BOOTSTRAP */
        /* DataTables thường tạo ra các thẻ label, ta nên định dạng chúng */
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }
    </style>
}