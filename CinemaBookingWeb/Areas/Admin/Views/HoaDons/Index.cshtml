@model IEnumerable<CinemaBookingWeb.Areas.Admin.Models.HoaDonChiTietVM>

@{
    ViewData["Title"] = "Quản lý Hóa đơn";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">@ViewData["Title"]</h3>
        <button onclick="location.reload();" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-repeat"></i> Làm mới
        </button>
    </div>

    <div class="table-responsive">
        <table id="tableHoaDon" class="table table-bordered table-striped table-hover align-middle nowrap" style="width:100%">
            <thead class="table-light text-center">
                <tr>
                    <th>Mã HĐ</th>
                    <th>Tên phim (Đại diện)</th>
                    <th>Suất chiếu</th>
                    <th>Phòng chiếu</th>
                    <th>Trạng thái</th>
                    <th>Tổng tiền</th>
                    <th data-type="date">Ngày đặt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr data-id="@o.MaHD">
                        <td>@o.MaHD</td>
                        <td>@o.TenPhim</td>
                        <td>@o.SuatChieu</td>
                        <td>@o.PhongChieu</td>
                        <td>
                            @{
                                string badgeClass = o.TrangThai switch
                                {
                                    "Đã thanh toán" => "bg-success",
                                    "Đã hủy" => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @badgeClass">@o.TrangThai</span>
                        </td>
                        <td>@String.Format("{0:N0}", o.TongTien) VNĐ</td>
                        <td data-sort="@o.NgayLap.ToString("yyyy-MM-dd HH:mm")">@o.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Bạn cần thêm MODAL xem chi tiết tương tự như file Đơn hàng cũ *@

@section Scripts {
   
    <script>
        $(document).ready(function () {
            // Khởi tạo DataTable
            const hoaDonTable = $('#tableHoaDon').DataTable({
                responsive: true,
                autoWidth: false,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json'
                },
                order: [[6, 'desc']]
            });

            // ✅ 1. Xử lý nút xem chi tiết (Mở Modal, nếu bạn có Modal)
            $('#tableHoaDon').on('click', '.btn-view-detail', function (e) {
                e.stopPropagation(); // NGĂN KHÔNG CHO SỰ KIỆN NÀY LAN TRUYỀN XUỐNG HÀNG TR
                const maHd = $(this).closest('tr').data('id');

                // Chuyển hướng đến trang Details khi bấm nút
                window.location.href = '/Admin/DonHang/ChiTiet/' + maHd;

                // Hoặc nếu bạn muốn mở modal, bạn gọi:
                // loadHoaDonDetails(maHd); // Gọi hàm tải dữ liệu modal
                // $("#modalHoaDon").modal('show');
            });

            // ✅ 2. XỬ LÝ CLICK VÀO HÀNG (ROW CLICK)
            $('#tableHoaDon tbody').on('click', 'tr', function (e) {
                // Kiểm tra: Nếu sự kiện click xuất phát từ hoặc bên trong nút, thì bỏ qua.
                if ($(e.target).closest('.btn-view-detail').length > 0 || $(e.target).is('button')) {
                    return;
                }

                // Lấy MaHD từ thuộc tính data-id của hàng
                const maHd = $(this).data('id');

                if (maHd) {
                    // Chuyển hướng đến trang Chi tiết
                    window.location.href = '/Admin/DonHang/ChiTiet/' + maHd;
                }
            });
        });
    </script>
}