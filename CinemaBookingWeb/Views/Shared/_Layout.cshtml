<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaBooking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>
<body>
    <!-- 🧭 HEADER -->
    <div class="container-header">
        <header class="header" id="header">
            <div class="logo">
                <h1>movie</h1>
            </div>
            <nav class="navBar">
                <div class="open-btn" id="open">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <div class="nav-items">
                    <ul class="list">
                        <li><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                        <li><a asp-controller="Film" asp-action="Index" class="active">Phim</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Liên Hệ</a></li>
                    </ul>
                    <div class="close-btn" id="close">
                        <i class="fa-solid fa-xmark"></i>
                    </div>
                    <ul class="user">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li>
                                @{
                                    var avatarFileName = User.Identity.IsAuthenticated ? User.FindFirst("Avatar")?.Value : "no-images.jpg";
                                    var avatarPath = $"/images/user/{avatarFileName}";
                                }
                                <a href="#" class="user-avatar-link">
                                    <img src="@avatarPath" alt="Avatar" class="user-avatar">
                                </a>
                                <div class="user-dropdown">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a href="/Admin/DashBoard">Trang quản trị</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Profile", "Account")">Xin chào, @User.Identity.Name</a>
                                    }
                                    <a href="@Url.Action("Logout", "Account")">Đăng Xuất</a>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="@Url.Action("Login", "Account")" class="login-text-link">
                                    Đăng Nhập <i class="fa-solid fa-right-to-bracket"></i>
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </nav>
        </header>
    </div>

    <!-- 🔹 PHẦN THÂN TRANG -->
        @RenderBody()

    <!-- 🦶 FOOTER -->
    <footer class="footer">
        <div class="footer-advise">
            <div>
                <ul>
                    <li><a href="@Url.Action("Index", "Contact")#gioithieu">Giới Thiệu</a></li>
                    <li><a href="@Url.Action("Index", "Contact")#lienhe">Liên Hệ</a></li>
                    <li><a href="@Url.Action("Index", "Contact")#chinhsach">Chính Sách</a></li>
                    <li><a href="@Url.Action("Index", "Contact")#huongdan">Hướng Dẫn</a></li>
                </ul>
            </div>
            <div class="advise-text">
                <p><small>Địa chỉ trụ sở: 3 Đ. Cầu Giấy, Ngọc Khánh, Đống Đa, Hà Nội, Việt Nam</small></p>
                <p><small>Giấy chứng nhận ĐKKD số: 0106633482 - Đăng ký lần đầu ngày 08/09/2014 tại Sở KH&ĐT TP Hà Nội</small></p>
            </div>
        </div>
        <div>
            <h4>Follow Us</h4>
            <div class="footer-social">
                <a href="https://www.instagram.com/sqw_uli"><i class="fa-brands fa-instagram"></i></a>
                <a href="https://www.facebook.com/Siluq.16"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="https://www.threads.net/sqw_uli"><i class="fa-brands fa-threads"></i></a>
            </div>
        </div>
        <div class="moblie-app">
            <h4>Movie App</h4>
            <div class="link-title">
                <a href="https://play.google.com/store/apps/details?id=com.cgv.android.movieapp" target="_blank"><img src="~/images/footer/01.jpg" alt=""></a>
                <a href="https://apps.apple.com/vn/app/cgv-cinemas/id1067166194" target="_blank"><img src="~/images/footer/02.jpg" alt=""></a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
