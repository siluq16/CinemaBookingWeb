@{
    ViewData["Title"] = "Truy Cập Bị Từ Chối";
}

<div class="container text-center py-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="display-1 text-danger">403</h1>
            <h2 class="mb-4">Truy Cập Bị Từ Chối</h2>
            <p class="lead">
                Rất tiếc, bạn không có quyền truy cập vào trang này.
                Vui lòng liên hệ quản trị viên nếu bạn tin rằng đây là một lỗi.
            </p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Quay về Trang Chủ</a>

            @if (User.Identity.IsAuthenticated && User.IsInRole("KhachHang"))
            {
                <p class="mt-3 text-muted">Bạn đã đăng nhập với vai trò Khách Hàng.</p>
            }
        </div>
    </div>
</div>