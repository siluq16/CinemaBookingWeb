@model CinemaBookingWeb.ViewModels.ChangePasswordViewModel
@{
}

<div class="card main-content-card bg-dark text-white rounded-3 shadow">
    <div class="card-header bg-danger text-white p-3">
        <h4 class="mb-0 fw-bold text-uppercase"><i class="fas fa-lock me-2"></i> CÀI MẬT MÃ THANH TOÁN</h4>
    </div>
    <div class="card-body p-4 p-md-5">

        <h5 class="fw-bold mb-3 text-danger">THAY ĐỔI MẬT KHẨU ĐĂNG NHẬP</h5>

        @if (ViewBag.SuccessMessage != null)    
        {
            <div class="alert alert-success">@ViewBag.SuccessMessage</div>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        <form id="changePasswordForm" asp-controller="Account" asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row info-details">
                <div class="col-12 mb-4">
                    <label asp-for="OldPassword" class="form-label fw-bold"></label>
                    <input asp-for="OldPassword" class="form-control" />
                    <span asp-validation-for="OldPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 mb-4">
                    <label asp-for="NewPassword" class="form-label fw-bold"></label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-danger px-4 fw-bold">ĐỔI MẬT KHẨU</button>
            </div>
        </form>

    </div>
</div>

<partial name="_ValidationScriptsPartial" />
<script>
    $(document).ready(function () {
        // 1. Gắn lại Unobtrusive Validation cho nội dung mới tải
        $.validator.unobtrusive.parse("#changePasswordForm");

        // 2. Chặn submit form mặc định và dùng AJAX
        $('#changePasswordForm').submit(function (e) {
            e.preventDefault(); // Ngăn chặn submit thông thường

            if ($(this).valid()) {

                // Hiển thị trạng thái loading
                $('#mainContentArea').html('<div class="text-center py-5 text-white"><i class="fas fa-spinner fa-spin fa-2x text-danger"></i><p class="mt-2">Đang đổi mật khẩu...</p></div>');

                $.ajax({
                    url: this.action,
                    type: this.method,
                    data: $(this).serialize(), // Dùng .serialize() vì không có file upload
                    success: function (data) {
                        // Controller trả về PartialView với SuccessMessage/ErrorMessage
                        $('#mainContentArea').html(data);
                    },
                    error: function (xhr, status, error) {
                        console.error("Lỗi khi đổi mật khẩu:", error);
                        $('#mainContentArea').html('<div class="alert alert-danger">Lỗi khi đổi mật khẩu. Vui lòng thử lại.</div>');
                    }
                });
            }
        });
    });
</script>