@model IEnumerable<CinemaBookingWeb.ViewModels.LichChieuItem>

@if (Model.Any())
{
    <div class="animate__animated animate__fadeIn">
        <div class="section-title mt-2">Giờ chiếu</div>

        <div class="time-list">
            @foreach (var item in Model)
            {
                <button class="btn btn-time btn-giochieu"
                        data-lichchieu="@item.MaLich"
                        data-giochieu="@item.GioBatDau.ToString("HH:mm:ss")"
                        data-ngaychieu="@item.NgayChieu.ToString("yyyy/MM/dd")">
                    @item.GioBatDau.ToString("HH:mm")
                </button>
            }
        </div>
    </div>
}
else
{
    <div class="text-center py-4">
        <i class="bi bi-calendar-x text-secondary fs-1"></i>
        <p class="text-secondary mt-2">Chưa có lịch chiếu cho ngày này.</p>
    </div>
}