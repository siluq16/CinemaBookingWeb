@model CinemaBookingWeb.ViewModels.LichChieuViewModel

<link href="~/css/lichchieu.css" rel="stylesheet" />
<div class="popup-overlay" id="lichChieuPopup">
    <div class="popup-content bg-dark text-light p-4 rounded-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-warning fw-bold">@Model.TenPhim</h4>
            <button class="btn btn-sm btn-outline-light close-popup">&times;</button>
        </div>

        <div class="text-center mb-3">
            <h5 class="text-danger">Chọn ngày chiếu</h5>
            <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
                @foreach (var ngay in Model.NgayChieuKhac)
                {
                    <button class="btn btn-outline-warning btn-chon-ngay"
                            data-ngay="@ngay.ToString("yyyy-MM-dd")"
                            data-phim="@Model.MaPhim">
                        @ngay.ToString("dd/MM")
                    </button>
                }
            </div>
        </div>

        <div id="lichChieuContainer">
            
        </div>
    </div>
</div>

<style>
    .popup-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .popup-content {
        width: 90%;
        max-width: 600px;
        animation: fadeIn 0.3s ease-in-out;
    }
    
</style>

<script>
    $(document).ready(function () {
        // chọn ngày → load lịch chiếu của ngày đó
        $(document).on("click", ".btn-chon-ngay", function () {
            var ngay = $(this).data("ngay");
            var maPhim = $(this).data("phim");

            $(".btn-chon-ngay").removeClass("active");
            $(this).addClass("active");

            $.get("/LichChieux/LichTheoNgay", { maPhim: maPhim, ngay: ngay }, function (data) {
                $("#lichChieuContainer").html(data);
            }).fail(function () {
                $("#lichChieuContainer").html("<p class='text-center text-danger mt-3'>Lỗi tải lịch chiếu.</p>");
            });
        });

        // Đóng popup
        $(document).on("click", ".close-popup", function () {
            $("#lichChieuPopup").fadeOut(200, function () { $(this).remove(); });
        });
    });
</script>
