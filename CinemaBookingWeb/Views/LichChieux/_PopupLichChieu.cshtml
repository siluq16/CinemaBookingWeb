@model CinemaBookingWeb.ViewModels.LichChieuViewModel
<link href="~/css/lichchieu.css" rel="stylesheet" asp-append-version="true" />

<div class="popup-overlay" id="lichChieuPopup">
    <div class="popup-content">
        <div class="popup-header">
            <h4 class="movie-title">@Model.TenPhim</h4>
            <button class="close-popup" title="Đóng">&times;</button>
        </div>

        <div class="popup-body">
            <div class="text-center">
                <div class="section-title">Chọn ngày chiếu</div>
                <div class="date-list">
                    @foreach (var ngay in Model.NgayChieuKhac)
                    {
                        <button class="btn btn-date btn-chon-ngay"
                                data-ngay="@ngay.ToString("yyyy-MM-dd")"
                                data-phim="@Model.MaPhim">
                            @ngay.ToString("dd/MM")
                        </button>
                    }
                </div>
            </div>

            <div id="lichChieuContainer">
                <p class="text-center text-secondary fst-italic mt-3">
                    Vui lòng chọn ngày để xem suất chiếu.
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Xử lý chọn ngày
        $(document).on("click", ".btn-chon-ngay", function () {
            var btn = $(this);
            var ngay = btn.data("ngay");
            var maPhim = btn.data("phim");

            // Hiệu ứng Active
            $(".btn-chon-ngay").removeClass("active");
            btn.addClass("active");

            // Hiệu ứng loading nhẹ
            $("#lichChieuContainer").html('<div class="text-center py-3 text-warning"><div class="spinner-border spinner-border-sm"></div> Đang tải suất chiếu...</div>');

            // Gọi Ajax
            $.get("/LichChieux/LichTheoNgay", { maPhim: maPhim, ngay: ngay }, function (data) {
                $("#lichChieuContainer").hide().html(data).fadeIn(300);
            }).fail(function () {
                $("#lichChieuContainer").html("<p class='text-center text-danger mt-3'>Không thể tải lịch chiếu.</p>");
            });
        });

        // Đóng popup
        $(document).on("click", ".close-popup, .popup-overlay", function (e) {
            if (e.target === this) { // Chỉ đóng khi click vào nền đen hoặc nút đóng
                $("#lichChieuPopup").fadeOut(200, function () { $(this).remove(); });
            }
        });
    });
</script>